# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase Postgres connection string, used directly by app/lib/db.ts (postgres.js,
# no ORM — see docs/adr/0004-service-boundary-and-schema-ownership.md).
# Standard postgres:// / postgresql:// URI, e.g.:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# If a direct connection isn't reachable from where this runs, use the Supavisor
# pooler connection string from the Supabase dashboard instead (same format BE
# uses in session mode, see backend/.env.example).
DATABASE_URL=
